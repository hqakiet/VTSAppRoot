            android:foreground="?attr/selectableItemBackground"
            android:gravity="center"
            android:maxLines="1"
            android:minWidth="150dp"
            android:minHeight="@dimen/Com_TouchMinHeight"
            android:stateListAnimator="@animator/lift_on_touch"
            android:text="@string/Com_Caption_QuyNay"
            app:rippleColor="@color/MyRipColor" />

    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <com.google.android.material.textview.MaterialTextView
            android:id="@+id/Picker_MaterialTextView_NamTruoc"
            style="@style/TitleTextViewLight"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:drawableStart="@drawable/ic_calendar_month"
            android:foreground="?attr/selectableItemBackground"
            android:gravity="center"
            android:maxLines="1"
            android:minWidth="150dp"
            android:minHeight="@dimen/Com_TouchMinHeight"
            android:stateListAnimator="@animator/lift_on_touch"
            android:text="@string/Com_Caption_NamTruoc"
            app:rippleColor="@color/MyRipColor" />

        <com.google.android.material.textview.MaterialTextView
            android:id="@+id/Picker_MaterialTextView_NamNay"
            style="@style/TitleTextViewLight"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:drawableStart="@drawable/ic_calendar_month"
            android:foreground="?attr/selectableItemBackground"
            android:gravity="center"
