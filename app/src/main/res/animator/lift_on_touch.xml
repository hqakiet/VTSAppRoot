<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Khi đang được nhấn (Pressed) -->
    <item android:state_pressed="true">
        <set>
            <objectAnimator
                android:propertyName="translationZ"
                android:duration="20"
                android:valueTo="0dp"
                android:valueType="floatType"/>
            <objectAnimator
                android:propertyName="scaleX"
                android:duration="20"
                android:valueTo="0.9"
                android:valueType="floatType"/>
            <objectAnimator
                android:propertyName="scaleY"
                android:duration="20"
                android:valueTo="0.9"
                android:valueType="floatType"/>
        </set>
    </item>

    <!-- Khi ở trạng thái bình thường (Default) -->
    <item>
        <set>
            <objectAnimator
                android:propertyName="translationZ"
                android:duration="10"
                android:valueTo="2dp"
                android:valueType="floatType"/>
            <objectAnimator
                android:propertyName="scaleX"
                android:duration="20"
                android:valueTo="1.0"
                android:valueType="floatType"/>
            <objectAnimator
                android:propertyName="scaleY"
                android:duration="10"
                android:valueTo="1.0"
                android:valueType="floatType"/>
        </set>
    </item>
</selector>