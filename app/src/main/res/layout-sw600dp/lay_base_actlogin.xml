<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <com.google.android.material.appbar.AppBarLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <com.google.android.material.appbar.MaterialToolbar
            android:id="@+id/ActLogin_MaterialToolbar"
            style="@style/AppToolbar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:subtitle="@string/ActLogin_Title"
            app:title="@string/app_name" />
    </com.google.android.material.appbar.AppBarLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true"
        android:scrollbars="vertical">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:clipChildren="false"
            android:clipToPadding="false"
            android:gravity="center|top"
            android:orientation="vertical"
            android:padding="@dimen/Com_TribblePadding">

            <ImageView
                android:layout_width="@dimen/Com_AppLogoSize"
                android:layout_height="@dimen/Com_AppLogoSize"
                android:contentDescription="@string/ComInfor_AppLogoDesc"
                android:src="@drawable/vts" />

            <com.google.android.material.card.MaterialCardView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/Com_TribblePadding"
                app:cardCornerRadius="@dimen/Com_FourPadding"
                app:cardElevation="@dimen/Com_Padding">

                <FrameLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:minWidth="@dimen/Com_MinWidth">

                    <LinearLayout
                        android:id="@+id/ActLogin_LinearLayout_Data"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center"
                        android:orientation="vertical"
                        android:paddingStart="@dimen/Com_TribblePadding"
                        android:paddingTop="@dimen/Com_TribblePadding"
                        android:paddingEnd="@dimen/Com_TribblePadding"
                        android:visibility="invisible">

                        <com.google.android.material.textfield.TextInputLayout
                            android:id="@+id/ActLogin_TextInputLayout_Account"
                            style="@style/AppTextInputLayout"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginBottom="@dimen/Com_TribblePadding"
                            android:hint="@string/ActLogin_TextView_Account_Hint"
                            app:helperText="@string/ActLogin_TextView_Account_Helper"
                            app:startIconDrawable="@drawable/icon_user">

                            <com.google.android.material.textfield.TextInputEditText
                                android:id="@+id/ActLogin_TextInputEditText_Account"
                                style="@style/AppTextInputEditText"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:inputType="text"
                                android:maxLength="50"
                                android:maxLines="1" />
                        </com.google.android.material.textfield.TextInputLayout>

                        <com.google.android.material.textfield.TextInputLayout
                            android:id="@+id/ActLogin_TextInputLayout_Password"
                            style="@style/AppTextInputLayout"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginBottom="@dimen/Com_TribblePadding"
                            android:hint="@string/ActLogin_EditText_Password_Hint"
                            app:endIconMode="password_toggle"
                            app:helperText="@string/ActLogin_EditText_Password_Helper"
                            app:startIconDrawable="@drawable/icon_lock">

                            <com.google.android.material.textfield.TextInputEditText
                                android:id="@+id/ActLogin_TextInputEditText_Password"
                                style="@style/AppTextInputEditText"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:inputType="textPassword"
                                android:maxLength="20"
                                android:maxLines="1" />
                        </com.google.android.material.textfield.TextInputLayout>

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginBottom="@dimen/Com_TribblePadding"
                            android:gravity="center_vertical"
                            android:minHeight="@dimen/Com_TouchMinHeightMax"
                            android:orientation="horizontal">

                            <com.google.android.material.checkbox.MaterialCheckBox
                                android:id="@+id/ActLogin_MaterialCheckBox_Agreement"
                                android:layout_width="@dimen/Com_TouchMinHeightMed"
                                android:layout_height="@dimen/Com_TouchMinHeightMed"
                                android:checked="false" />

                            <com.google.android.material.textview.MaterialTextView
                                android:id="@+id/ActLogin_MaterialTextView_Agreement"
                                style="@style/GroupHeaderTextViewLight"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:gravity="center|start"
                                android:text="@string/ActLogin_TextView_Agreement"
                                android:textSize="@dimen/Com_HeaderFontSize" />

                        </LinearLayout>

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/ActLogin_MaterialButton_Confirm"
                            style="@style/AppButonCommands"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginBottom="@dimen/Com_Padding"
                            android:enabled="false"
                            android:minHeight="@dimen/Com_TouchMinHeightMed"
                            android:text="@string/ActLogin_Button_Confirm" />

                        <com.google.android.material.textview.MaterialTextView
                            style="@style/GroupHeaderTextViewLight"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginBottom="@dimen/Com_Padding"
                            android:gravity="center"
                            android:text="@string/ActLogin_TextView_Confirm_Account"
                            android:textStyle="italic|bold" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/ActLogin_MaterialButton_Google"
                            style="@style/AppButonCommands"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginBottom="@dimen/Com_TribblePadding"
                            android:enabled="false"
                            android:gravity="center"
                            android:minHeight="@dimen/Com_TouchMinHeightMed"
                            android:text="@string/ActLogin_Button_Google_Confirm"
                            app:icon="@drawable/googleg_standard_color_18"
                            app:iconGravity="textStart"
                            app:iconPadding="@dimen/Com_TribblePadding"
                            app:iconTint="@null" />

                    </LinearLayout>

                    <include layout="@layout/inclay_base_waiting" />

                </FrameLayout>

            </com.google.android.material.card.MaterialCardView>

        </LinearLayout>

    </ScrollView>

    <include layout="@layout/inclay_base_footer" />

</LinearLayout>